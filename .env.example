# -----------------------------------------------------------------------------
# KHELNA BAZAR - Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit your actual .env file or credentials to GitHub!

# Database (Neon Serverless PostgreSQL)
# Example pooled connection: postgresql://username:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth v5
# Generate a secure secret using: openssl rand -base64 32
AUTH_SECRET="your-generated-super-secret-random-key-at-least-32-chars-long"
AUTH_URL="http://localhost:3000"

# Optional Google OAuth (leave empty if not using Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Site Public Config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="KHELNA BAZAR"
NEXT_PUBLIC_CURRENCY_CODE="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Transactional Email via Resend (Optional - emails will log to console in development if omitted)
RESEND_API_KEY=""
EMAIL_FROM="Khelna Bazar <orders@khelnabazar.com>"

# Admin Cron Secret (for Vercel Cron jobs)
CRON_SECRET="your-random-cron-secret-token"
